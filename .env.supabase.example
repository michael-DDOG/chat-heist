# ============================================
# CHAT HEIST - SUPABASE CONFIGURATION
# ============================================
# Complete this file with your actual values and save as .env

# ============================================
# TELEGRAM CONFIGURATION
# ============================================
# Get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_GAME_SHORT_NAME=CHAT_HEIST

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Your Project URL: https://rgmtcjkgbtoxyqwdwpsk.supabase.co

# 1. DATABASE_URL - Get from Supabase Dashboard:
#    Settings → Database → Connection String → "Session mode"
#    Port 6543 (pooled connection for Prisma)
#
#    Format:
#    postgresql://postgres.rgmtcjkgbtoxyqwdwpsk:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
#    Replace [YOUR-DB-PASSWORD] with your database password
#    Replace [REGION] with your region (e.g., us-east-1, eu-west-1)
DATABASE_URL=postgresql://postgres.rgmtcjkgbtoxyqwdwpsk:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# 2. SUPABASE_URL - Your project URL (fixed)
SUPABASE_URL=https://rgmtcjkgbtoxyqwdwpsk.supabase.co

# 3. SUPABASE_SERVICE_ROLE_KEY - Get from Supabase Dashboard:
#    Settings → API → Service Role → service_role secret
#    ⚠️ KEEP THIS SECRET! Only use on backend, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ============================================
# UPSTASH REDIS CONFIGURATION
# ============================================
# Get from: https://console.upstash.com/
#
# 1. Create Redis database
# 2. Copy REST API URL
#    Format: rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Leave empty during development, fill after starting tunnel
APP_BASE_URL=

# Environment
NODE_ENV=development

# Server port
PORT=3000

# ============================================
# SECURITY
# ============================================
# Generate random 32-character hex strings:
# Linux/Mac: openssl rand -hex 32
# Windows: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })

WEBHOOK_SECRET=generate_random_32_char_hex_string_here
JWT_SECRET=generate_random_32_char_hex_string_here
