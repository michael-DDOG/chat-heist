{
  "info": {
    "name": "Chat Heist API",
    "description": "API collection for Chat Heist Telegram game",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Verify InitData",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', data.token);",
                  "    console.log('Token saved:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initData\": \"query_id=AAHdF6IQAAAAAN0XohDhrOrc&user=%7B%22id%22%3A123456789%2C%22first_name%22%3A%22Test%22%2C%22last_name%22%3A%22User%22%2C%22username%22%3A%22testuser%22%7D&auth_date=1234567890&hash=abcdef123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verifyInitData",
              "host": ["{{base_url}}"],
              "path": ["auth", "verifyInitData"]
            }
          }
        }
      ]
    },
    {
      "name": "Game",
      "item": [
        {
          "name": "Start Run",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('run_id', data.runId);",
                  "    console.log('Run ID saved:', data.runId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"difficulty\": 2,\n  \"mode\": \"SOLO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/start",
              "host": ["{{base_url}}"],
              "path": ["game", "start"]
            }
          }
        },
        {
          "name": "Complete Run",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"runId\": \"{{run_id}}\",\n  \"score\": 5000,\n  \"eventsCompleted\": 8,\n  \"inputs\": 120,\n  \"checksum\": \"abc123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/game/complete",
              "host": ["{{base_url}}"],
              "path": ["game", "complete"]
            }
          }
        }
      ]
    },
    {
      "name": "Leaderboard",
      "item": [
        {
          "name": "Get Global Leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leaderboard/global?limit=10",
              "host": ["{{base_url}}"],
              "path": ["leaderboard", "global"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get Chat Leaderboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/leaderboard/chat/-1001234567890?limit=10",
              "host": ["{{base_url}}"],
              "path": ["leaderboard", "chat", "-1001234567890"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Shop",
      "item": [
        {
          "name": "Get Shop Gear",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shop/gear",
              "host": ["{{base_url}}"],
              "path": ["shop", "gear"]
            }
          }
        },
        {
          "name": "Buy Gear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gearType\": \"HACKER_RIG\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/shop/buy",
              "host": ["{{base_url}}"],
              "path": ["shop", "buy"]
            }
          }
        }
      ]
    },
    {
      "name": "Dailies",
      "item": [
        {
          "name": "Get Daily Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dailies",
              "host": ["{{base_url}}"],
              "path": ["dailies"]
            }
          }
        },
        {
          "name": "Claim Daily Task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskId\": \"clxxxxxxxxxxxxxx\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/dailies/claim",
              "host": ["{{base_url}}"],
              "path": ["dailies", "claim"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        }
      ]
    },
    {
      "name": "Telegram Bot",
      "item": [
        {
          "name": "Set Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{base_url}}/telegram/webhook\"\n}"
            },
            "url": {
              "raw": "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/setWebhook",
              "protocol": "https",
              "host": ["api", "telegram", "org"],
              "path": ["bot<YOUR_BOT_TOKEN>", "setWebhook"]
            }
          }
        },
        {
          "name": "Get Webhook Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getWebhookInfo",
              "protocol": "https",
              "host": ["api", "telegram", "org"],
              "path": ["bot<YOUR_BOT_TOKEN>", "getWebhookInfo"]
            }
          }
        }
      ]
    }
  ]
}
