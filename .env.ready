# ============================================
# SECURITY KEYS
# ============================================
# TODO: Generate two random 32-character hex strings
#
# On Linux/Mac:
#   openssl rand -hex 32
#
# On Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#
# Run the command twice to get two different keys

WEBHOOK_SECRET=PASTE_FIRST_RANDOM_32_CHAR_HEX_HERE
JWT_SECRET=PASTE_SECOND_RANDOM_32_CHAR_HEX_HERE
