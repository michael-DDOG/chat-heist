{
  "name": "chat-heist",
  "version": "1.0.0",
  "description": "Fast, social, replayable heist runs for Telegram groups",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && vite build web",
    "start": "node dist/server.js",
    "postdeploy": "npm run migrate:deploy",
    "migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "set:webhook": "tsx scripts/setWebhook.ts",
    "tunnel": "node scripts/tunnel.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src web/src",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "telegram",
    "game",
    "mini-app",
    "phaser"
  ],
  "engines": {
    "node": "20.x"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@upstash/redis": "^1.35.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/supertest": "^6.0.2",
    "phaser": "^3.87.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
